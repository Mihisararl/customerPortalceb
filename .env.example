# CEB API Configuration
# Copy this file to .env and fill in your actual credentials

# API Base URL (only needed if different from proxy configuration)
# VITE_API_BASE_URL=http://10.128.1.59:6001

# Authentication Method: Choose ONE of the following:

# Option 1: API Key Authentication
# VITE_API_KEY=your_api_key_here

# Option 2: Bearer Token Authentication
# VITE_API_TOKEN=your_bearer_token_here

# Option 3: Basic Authentication (Username & Password)
# VITE_API_USERNAME=your_username
# VITE_API_PASSWORD=your_password

# Note: Contact your CEB API administrator for the correct credentials
